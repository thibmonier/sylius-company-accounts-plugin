<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">
    <class name="Tmonier\SyliusCompanyAccountsPlugin\Entity\CompanyAddress">
        <property name="label">
            <constraint name="NotBlank">
                <option name="message">tmonier_company_accounts.address.label.not_blank</option>
                <option name="groups">sylius</option>
            </constraint>
            <constraint name="Length">
                <option name="max">255</option>
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <!-- The Sylius address rules (street, city, postcode, country...) apply to the nested address. -->
        <property name="address">
            <constraint name="NotNull">
                <option name="groups">sylius</option>
            </constraint>
            <constraint name="Valid" />
        </property>
    </class>
</constraint-mapping>
