<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">
    <class name="Tmonier\SyliusCompanyAccountsPlugin\Entity\Company">
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">code</option>
            <option name="message">tmonier_company_accounts.company.code.unique</option>
            <option name="groups">sylius</option>
        </constraint>
        <property name="code">
            <constraint name="NotBlank">
                <option name="message">tmonier_company_accounts.company.code.not_blank</option>
                <option name="groups">sylius</option>
            </constraint>
            <constraint name="Length">
                <option name="max">64</option>
                <option name="groups">sylius</option>
            </constraint>
            <constraint name="Regex">
                <option name="pattern">/^[\w-]*$/</option>
                <option name="message">tmonier_company_accounts.company.code.regex</option>
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="name">
            <constraint name="NotBlank">
                <option name="message">tmonier_company_accounts.company.name.not_blank</option>
                <option name="groups">sylius</option>
            </constraint>
            <constraint name="Length">
                <option name="max">255</option>
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="vatNumber">
            <constraint name="Length">
                <option name="max">32</option>
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="registrationNumber">
            <constraint name="Length">
                <option name="max">64</option>
                <option name="groups">sylius</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
