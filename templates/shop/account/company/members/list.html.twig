{% set company = hookable_metadata.context.company %}
{% set viewer = hookable_metadata.context.member %}
{% set can_manage = is_granted('COMPANY_MANAGE_MEMBERS', company) %}

{% include '@SyliusShop/shared/flashes.html.twig' %}

<div class="table-responsive">
    <table class="table align-middle" {{ sylius_test_html_attribute('tmonier-company-members') }}>
        <thead>
            <tr>
                <th scope="col">{{ 'sylius.ui.name'|trans }}</th>
                <th scope="col">{{ 'tmonier_company_accounts.ui.role'|trans }}</th>
                <th scope="col">{{ 'sylius.ui.enabled'|trans }}</th>
                {% if can_manage %}<th scope="col"><span class="visually-hidden">{{ 'sylius.ui.actions'|trans }}</span></th>{% endif %}
            </tr>
        </thead>
        <tbody>
            {% for member in hookable_metadata.context.members %}
                {% set is_me = member.id == viewer.id %}
                {% set name = member.customer.fullName|trim ?: '-' %}
                {% set form_id = 'tmonier-member-form-' ~ member.id %}
                <tr {{ sylius_test_html_attribute('tmonier-company-member', member.id) }}>
                    <th scope="row" class="fw-normal" id="tmonier-member-name-{{ member.id }}">
                        {{ name }}
                        {% if is_me %}<span class="badge text-bg-light">{{ 'tmonier_company_accounts.ui.you'|trans }}</span>{% endif %}
                    </th>
                    {% if can_manage and not is_me %}
                        <td>
                            <select name="role" form="{{ form_id }}" class="form-select form-select-sm w-auto" aria-label="{{ 'tmonier_company_accounts.ui.role_of'|trans({'%member%': name}) }}">
                                {% for role in hookable_metadata.context.roles %}
                                    <option value="{{ role }}" {{ role == member.role ? 'selected' }}>{{ ('tmonier_company_accounts.role.' ~ role)|trans }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td>
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" name="enabled" value="1" form="{{ form_id }}" id="tmonier-member-enabled-{{ member.id }}" {{ member.enabled ? 'checked' }}>
                                <label class="form-check-label" for="tmonier-member-enabled-{{ member.id }}">{{ 'sylius.ui.enabled'|trans }}<span class="visually-hidden"> ({{ name }})</span></label>
                            </div>
                        </td>
                        <td class="text-end">
                            <form method="post" id="{{ form_id }}" action="{{ path('tmonier_company_accounts_shop_company_member_update', {'id': member.id}) }}" {{ sylius_test_html_attribute('tmonier-company-member-form', member.id) }}>
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('tmonier_company_member_' ~ member.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-primary">{{ 'sylius.ui.save'|trans }}<span class="visually-hidden"> ({{ name }})</span></button>
                            </form>
                        </td>
                    {% else %}
                        <td>{{ ('tmonier_company_accounts.role.' ~ member.role)|trans }}</td>
                        <td>{{ member.enabled ? 'sylius.ui.enabled'|trans : 'sylius.ui.disabled'|trans }}</td>
                        {% if can_manage %}<td></td>{% endif %}
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
<p class="text-body-secondary small">{{ (can_manage ? 'tmonier_company_accounts.ui.members_admin_help' : 'tmonier_company_accounts.ui.members_help')|trans }}</p>
