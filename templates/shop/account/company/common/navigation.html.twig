{#
 # Tab bar of the "My company" pages. Each tab is a hookable of the
 # `tmonier_company_accounts.shop.account.company.tabs` hook (an <li class="nav-item">), so other
 # plugins add their own. Context of the tabs: company, member, active_tab (overview, members,
 # orders, or the key a page of another plugin passes as `active_tab`).
 # Another plugin's page renders this same template with company, member and active_tab.
 #}
{% set context = hookable_metadata.context %}
{% set page_tabs = {'show': 'overview', 'members': 'members', 'orders': 'orders', 'addresses': 'addresses', 'address_form': 'addresses'} %}
{% set active_tab = context.active_tab|default(page_tabs[context.page|default('')]|default(null)) %}

<ul class="nav nav-tabs mt-4" {{ sylius_test_html_attribute('tmonier-company-navigation') }}>
    {% hook 'tmonier_company_accounts.shop.account.company.tabs' with { company: context.company, member: context.member, active_tab: active_tab, _prefixes: [] } %}
</ul>
