{% set member = tmonier_company_current_member() %}

{% if member is not null and is_granted('COMPANY_VIEW', member.company) %}
    <div class="card border-0 bg-body-tertiary mt-4" {{ sylius_test_html_attribute('tmonier-dashboard-company') }}>
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="fw-semibold">{{ member.company.name }}</div>
                <div class="text-body-secondary">{{ 'tmonier_company_accounts.ui.your_role'|trans }}: {{ ('tmonier_company_accounts.role.' ~ member.role)|trans }}</div>
            </div>
            <a class="btn btn-outline-primary" href="{{ path('tmonier_company_accounts_shop_company_show') }}">{{ 'tmonier_company_accounts.ui.my_company'|trans }}</a>
        </div>
    </div>
{% endif %}
